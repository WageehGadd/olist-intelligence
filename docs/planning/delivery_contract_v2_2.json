{
  "schema_version": "purchase-v1",
  "snapshot": "purchase_creation",
  "raw_fields": {
    "purchase_timestamp": {
      "type": "ISO local naive datetime",
      "required": true
    },
    "estimated_delivery_date": {
      "type": "ISO date",
      "required": true
    },
    "customer_state": {
      "type": "Brazilian state code",
      "required": true
    },
    "items": {
      "type": "nonempty array of unit items",
      "required": true,
      "required_fields": [
        "product_key",
        "seller_key",
        "price_brl",
        "freight_value_brl"
      ]
    }
  },
  "features": [
    {
      "name": "item_count",
      "transformation": "len(items)",
      "source": "order_items.order_item_id",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "item_price",
      "transformation": "sum(item.price_brl)",
      "source": "order_items.price",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "freight",
      "transformation": "sum(item.freight_value_brl)",
      "source": "order_items.freight_value",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "seller_count",
      "transformation": "count distinct seller_key",
      "source": "order_items.seller_id",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "product_count",
      "transformation": "count distinct product_key",
      "source": "order_items.product_id",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "purchase_hour",
      "transformation": "hour(purchase_timestamp)",
      "source": "orders.order_purchase_timestamp",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "purchase_weekday",
      "transformation": "weekday(purchase_timestamp), Monday=0",
      "source": "orders.order_purchase_timestamp",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "purchase_month",
      "transformation": "month(purchase_timestamp)",
      "source": "orders.order_purchase_timestamp",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "promise_days",
      "transformation": "(estimated_delivery_date at midnight - purchase_timestamp).total_seconds / 86400",
      "source": "orders.order_estimated_delivery_date; order_purchase_timestamp",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    },
    {
      "name": "customer_state",
      "transformation": "customer_state, train-only one-hot",
      "source": "customers.customer_state",
      "inference_source": "computed from user-entered request",
      "earliest_availability": "purchase creation (cart/promise snapshot assumption)",
      "missing_behavior": "422 for missing mandatory raw fields"
    }
  ],
  "forbidden_inputs": [
